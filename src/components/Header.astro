---
import { nav, site, socials } from '@data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
	<div class="wrap bar">
		<a class="name" href="/" aria-label={`${site.name}, accueil`}>{site.name}</a>
		<p class="blurb">Technicien supérieur<span class="blurb-long"> en informatique</span><br />cofondateur et CTO d’Artinova</p>
		<p class="clock" data-clock-wrap>
			<span>{site.location}</span>
			<time data-clock></time>
		</p>
		<nav class="nav" aria-label="Navigation principale">
			{
				nav.map((item) => (
					<a class="u-link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
		</nav>
		<button class="menu-btn" type="button" popovertarget="menu" aria-label="Ouvrir le menu">Menu</button>
	</div>

	<nav id="menu" class="menu" popover aria-label="Menu principal">
		<div class="wrap menu-top">
			<span class="name">{site.name}</span>
			<button class="menu-btn" type="button" popovertarget="menu" popovertargetaction="hide">Fermer</button>
		</div>
		<ul class="wrap menu-links">
			<li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Accueil</a></li>
			{
				nav.map((item) => (
					<li>
						<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
		<ul class="wrap menu-socials">
			{
				socials.map((s) => (
					<li>
						<a class="u-link" href={s.href} rel="noopener">
							{s.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	.site-header {
		position: fixed;
		inset: 0 0 auto;
		z-index: 50;
		view-transition-name: site-header;
		background: color-mix(in srgb, var(--bg) 0%, transparent);
	}

	@supports (animation-timeline: scroll()) {
		.site-header {
			animation: header-fill linear both;
			animation-timeline: scroll(root);
			animation-range: 0 40vh;
		}
	}

	@supports not (animation-timeline: scroll()) {
		.site-header {
			background: color-mix(in srgb, var(--bg) 88%, transparent);
		}
	}

	@keyframes header-fill {
		to {
			background: color-mix(in srgb, var(--bg) 92%, transparent);
			border-bottom-color: var(--line);
		}
	}

	.site-header {
		border-bottom: 1px solid transparent;
	}

	.bar {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		align-items: center;
		column-gap: 1.25rem;
		height: var(--header-h);
		font-size: 0.8rem;
		font-weight: 600;
		font-stretch: 85%;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.name {
		grid-column: 1 / span 3;
		font-size: 0.95rem;
		font-weight: 800;
		font-stretch: 75%;
		letter-spacing: 0.02em;
		white-space: nowrap;
	}

	.blurb {
		grid-column: 4 / span 3;
		color: var(--muted);
		line-height: 1.25;
	}

	/* Entre 900 et 1200 px, la forme courte tient sur deux lignes. */
	@media (max-width: 1200px) {
		.blurb-long {
			display: none;
		}
	}

	.clock {
		grid-column: 7 / span 2;
		display: flex;
		gap: 0.6em;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.clock time {
		color: var(--fg);
	}

	@media (scripting: none) {
		.clock {
			visibility: hidden;
		}
	}

	.nav {
		grid-column: 9 / span 4;
		display: flex;
		justify-content: flex-end;
		gap: clamp(1rem, 2.4vw, 2.4rem);
	}

	.menu-btn {
		display: none;
		justify-self: end;
		padding: 0.55rem 0;
		font-size: 0.8rem;
		font-weight: 700;
		font-stretch: 85%;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	@media (max-width: 900px) {
		.blurb,
		.clock,
		.nav {
			display: none;
		}

		.name {
			grid-column: 1 / span 8;
		}

		.menu-btn {
			display: block;
			grid-column: 9 / span 4;
		}
	}

	/* Menu mobile plein écran : popover natif, sans JS. */
	.menu {
		inset: 0;
		width: 100%;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0 0 2rem;
		border: 0;
		background: var(--bg);
		color: var(--fg);
		flex-direction: column;
	}

	.menu:popover-open {
		display: flex;
	}

	.menu-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: var(--header-h);
	}

	.menu-top .menu-btn {
		display: block;
	}

	.menu-links {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.2em;
		font-size: clamp(3rem, 16vw, 7rem);
		font-weight: 800;
		font-stretch: 75%;
		line-height: 0.92;
		text-transform: uppercase;
	}

	.menu-links a[aria-current='page'] {
		color: var(--muted);
	}

	.menu-socials {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
</style>
