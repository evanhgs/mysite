---
import { nav, site, socials } from '@data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap">
		<a class="cta" href="/contact/">
			<span class="label">Un projet sérieux, une opportunité, une question ?</span>
			<span class="display cta-word">Écrivez-moi<span class="arrow" aria-hidden="true">↗</span></span>
		</a>

		<div class="cols">
			<nav aria-label="Pied de page">
				<p class="label">Plan</p>
				<ul>
					<li><a class="u-link" href="/">Accueil</a></li>
					{
						nav.map((item) => (
							<li>
								<a class="u-link" href={item.href}>
									{item.label}
								</a>
							</li>
						))
					}
					<li><a class="u-link" href="/mentions-legales/">Mentions légales</a></li>
				</ul>
			</nav>

			<div>
				<p class="label">Ailleurs</p>
				<ul>
					{
						socials.map((s) => (
							<li>
								<a class="u-link" href={s.href} rel="noopener">
									{s.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="meta">
				<button class="motion" type="button" data-motion-toggle aria-pressed="true">
					<span class="label">Animations</span>
					<span data-motion-state>activées</span>
				</button>
				<p class="muted">© {year} {site.name}</p>
				<p class="muted">Site statique fait avec Astro et Three.js, sans aucun cookie.</p>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		z-index: 2;
		padding-block: var(--section) 2rem;
		border-top: 1px solid var(--line);
		background: var(--bg);
	}

	.cta {
		display: grid;
		gap: 1.25rem;
		padding-bottom: clamp(3rem, 7vw, 6rem);
	}

	.cta-word {
		display: flex;
		align-items: flex-start;
		gap: 0.08em;
		transition: color 0.4s var(--ease-out);
	}

	.cta-word .arrow {
		font-size: 0.5em;
		font-weight: 600;
	}

	.cta:hover .cta-word,
	.cta:focus-visible .cta-word {
		color: var(--muted);
	}

	.cta:hover .arrow,
	.cta:focus-visible .arrow {
		transform: translate(0.12em, -0.12em);
	}

	.cols {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 2.5rem 1.25rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--line);
	}

	.cols > :nth-child(1) {
		grid-column: 1 / span 3;
	}

	.cols > :nth-child(2) {
		grid-column: 4 / span 3;
	}

	.meta {
		grid-column: 9 / span 4;
		display: grid;
		gap: 0.4rem;
		align-content: start;
		justify-items: end;
		text-align: right;
		font-size: var(--t-small);
	}

	.cols .label {
		margin-bottom: 1rem;
	}

	.cols li {
		margin-bottom: 0.4rem;
	}

	.motion {
		display: inline-flex;
		align-items: baseline;
		gap: 0.75rem;
		margin-bottom: 1rem;
		font-weight: 600;
	}

	.motion .label {
		margin: 0;
	}

	.motion[aria-pressed='false'] [data-motion-state] {
		color: var(--muted);
	}

	@media (scripting: none) {
		.motion {
			display: none;
		}
	}

	@media (max-width: 760px) {
		.cols > :nth-child(1),
		.cols > :nth-child(2) {
			grid-column: span 6;
		}

		.meta {
			grid-column: 1 / -1;
			justify-items: start;
			text-align: left;
		}
	}
</style>
