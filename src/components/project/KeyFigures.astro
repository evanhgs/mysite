---
interface Props {
	figures: { value: string; label: string }[];
}

const { figures } = Astro.props;
---

{
	figures.length > 0 && (
		<section class="figures wrap" aria-label="Chiffres clés">
			<ul style={`--n: ${figures.length}`}>
				{figures.map((f) => (
					<li class="reveal">
						<span class="value">{f.value}</span>
						<span class="what">{f.label}</span>
					</li>
				))}
			</ul>
		</section>
	)
}

<style>
	.figures ul {
		display: grid;
		grid-template-columns: repeat(var(--n), minmax(0, 1fr));
		border-top: 1px solid var(--line);
	}

	li {
		display: grid;
		align-content: start;
		gap: 0.7rem;
		padding: 1.6rem 1.5rem 0 0;
	}

	li + li {
		padding-left: 1.5rem;
		border-left: 1px solid var(--line);
	}

	.value {
		font-size: clamp(2.4rem, 5.2vw, 5rem);
		font-weight: 800;
		font-stretch: 75%;
		line-height: 0.9;
		color: var(--accent);
		white-space: nowrap;
	}

	.what {
		max-width: 22ch;
		color: var(--muted);
		font-size: var(--t-small);
		line-height: 1.4;
	}

	@media (max-width: 760px) {
		.figures ul {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		li:nth-child(odd) {
			padding-left: 0;
			border-left: 0;
		}

		li:nth-child(n + 3) {
			margin-top: 1.5rem;
			border-top: 1px solid var(--line);
		}
	}
</style>
