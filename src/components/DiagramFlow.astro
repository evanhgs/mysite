---
// Schéma d'architecture en SVG, généré depuis les données du projet.
// Deux variantes : large (desktop) et transposée (mobile). Le SVG est
// décoratif pour les lecteurs d'écran ; la liste des flux le remplace.
import { DESKTOP, MOBILE, layoutDiagram, type Diagram } from '@lib/diagram';

interface Props {
	diagram: Diagram;
	id: string;
}

const { diagram, id } = Astro.props;
const variants = [
	{ key: 'wide', layout: layoutDiagram(diagram, DESKTOP) },
	{ key: 'tall', layout: layoutDiagram(diagram, MOBILE) },
];
const kindLabel: Record<string, string> = {
	client: 'interface',
	service: 'service',
	worker: 'worker',
	store: 'stockage',
	queue: 'file',
	external: 'service externe',
};
---

<figure class="diagram" aria-labelledby={`${id}-cap`}>
	{
		variants.map(({ key, layout }) => {
			const v = layout.variant;
			const arrow = `${id}-${key}-arrow`;
			return (
				<svg
					class={`dg dg--${key}`}
					viewBox={`-6 -6 ${layout.width + 12} ${layout.height + 12}`}
					style={`--vbw: ${layout.width}px`}
					aria-hidden="true"
					focusable="false"
				>
					<defs>
						<marker id={arrow} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
							<path d="M0 0 L10 5 L0 10 z" />
						</marker>
					</defs>
					{layout.edges.map((e) => (
						<g class={`edge edge--${e.flow}`}>
							<path d={e.d} marker-end={`url(#${arrow})`} marker-start={e.both ? `url(#${arrow})` : undefined} />
							{e.label && !e.labelHidden && (
								<g class="edge-label">
									<rect
										x={e.labelX - e.labelWidth / 2}
										y={e.labelY - v.edgeLabel * 0.85}
										width={e.labelWidth}
										height={v.edgeLabel * 1.7}
									/>
									<text x={e.labelX} y={e.labelY} font-size={v.edgeLabel} dominant-baseline="middle" text-anchor="middle">
										{e.label}
									</text>
								</g>
							)}
						</g>
					))}
					{layout.nodes.map((n) => (
						<g class={`node node--${n.kind}`}>
							<rect x={n.x} y={n.y} width={n.w} height={n.h} />
							{n.kind === 'worker' && <rect class="inner" x={n.x + 5} y={n.y + 5} width={n.w - 10} height={n.h - 10} />}
							{n.kind === 'store' && <line x1={n.x} x2={n.x + n.w} y1={n.y + n.h * 0.16} y2={n.y + n.h * 0.16} />}
							{n.kind === 'queue' &&
								[0, 1, 2].map((i) => <line x1={n.x + n.w - 12 - i * 9} x2={n.x + n.w - 12 - i * 9} y1={n.y + 10} y2={n.y + n.h - 10} />)}
							{n.kind === 'service' && <rect class="mark" x={n.x + 8} y={n.y + 8} width={n.h * 0.09} height={n.h * 0.09} />}
							<text class="node-label" x={n.cx} y={n.sub ? n.cy - v.sub * 0.55 : n.cy} font-size={v.label} dominant-baseline="middle" text-anchor="middle">
								{n.label}
							</text>
							{n.sub && (
								<text class="node-sub" x={n.cx} y={n.cy + v.label * 0.7} font-size={v.sub} dominant-baseline="middle" text-anchor="middle">
									{n.sub}
								</text>
							)}
						</g>
					))}
				</svg>
			);
		})
	}
	<figcaption id={`${id}-cap`} class="label">{diagram.title}</figcaption>
	<ul class="sr-only">
		{diagram.nodes.map((n) => <li>{`${n.label} (${kindLabel[n.kind]}${n.sub ? ', ' + n.sub : ''})`}</li>)}
		{
			variants[0].layout.edges.map((e) => (
				<li>{`${e.fromLabel} ${e.both ? 'échange avec' : 'vers'} ${e.toLabel}${e.label ? ', ' + e.label : ''}`}</li>
			))
		}
	</ul>
</figure>

<style>
	.diagram {
		display: grid;
		gap: 1.25rem;
		margin-block: clamp(2.5rem, 5vw, 4.5rem);
		padding: clamp(1.25rem, 3vw, 2.5rem);
		border: 1px solid var(--line);
		background: color-mix(in srgb, var(--bg-raised) 60%, var(--bg));
	}

	.dg {
		width: 100%;
		height: auto;
		margin-inline: auto;
		overflow: visible;
		font-family: var(--font);
	}

	.dg--wide {
		max-width: var(--vbw);
	}

	.dg--tall {
		display: none;
		max-width: 30rem;
	}

	@media (max-width: 720px) {
		.dg--wide {
			display: none;
		}

		.dg--tall {
			display: block;
		}
	}

	.node rect {
		fill: var(--bg);
		stroke: var(--fg);
		stroke-width: 1.5;
	}

	.node--service > rect:first-child {
		fill: var(--bg-raised);
	}

	.node .mark {
		fill: var(--accent);
		stroke: none;
	}

	.node .inner {
		fill: none;
		stroke: var(--line-strong);
	}

	.node line {
		stroke: var(--line-strong);
		stroke-width: 1.5;
	}

	.node--external rect {
		stroke: var(--muted);
		stroke-dasharray: 5 5;
	}

	.node-label {
		fill: var(--fg);
		font-weight: 650;
		font-stretch: 90%;
	}

	.node-sub {
		fill: var(--muted);
		font-weight: 450;
	}

	.edge path {
		fill: none;
		stroke: color-mix(in srgb, var(--fg) 55%, transparent);
		stroke-width: 1.5;
	}

	.edge marker path,
	.dg marker path {
		fill: var(--fg);
	}

	.edge--async path,
	.edge--stream path {
		stroke: var(--accent);
		stroke-dasharray: 6 7;
	}

	@media (prefers-reduced-motion: no-preference) {
		html:not([data-motion='off']) .edge--async path,
		html:not([data-motion='off']) .edge--stream path {
			animation: flow 1.4s linear infinite;
		}
	}

	@keyframes flow {
		to {
			stroke-dashoffset: -26;
		}
	}

	.edge-label rect {
		fill: var(--bg);
	}

	.edge-label text {
		fill: var(--muted);
		font-weight: 550;
	}

	figcaption {
		text-align: center;
	}
</style>
