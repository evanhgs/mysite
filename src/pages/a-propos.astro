---
import Base from '@layouts/Base.astro';
import { artinova, education, site, skills, socials } from '@data/site';
import { abs, breadcrumbNode, graph, PERSON_ID, personNode, artinovaNode } from '@lib/seo';
import type { Thing } from 'schema-dts';

const profilePage = {
	'@type': 'ProfilePage',
	'@id': abs('/a-propos/#page'),
	url: abs('/a-propos/'),
	name: `À propos de ${site.name}`,
	inLanguage: 'fr-FR',
	mainEntity: { '@id': PERSON_ID },
} as Thing;

const path = [
	{ when: '2026 — aujourd’hui', what: `Cofondateur et CTO d’Artinova`, detail: 'Architecture, back-end, infrastructure et qualité d’un SaaS pour les artisans du bâtiment, en bêta.' },
	{ when: 'Formation', what: `${education.degree}, ${education.school}`, detail: 'Bac+3 en informatique, diplômé. Projets tuteurés pour de vrais commanditaires, dont Aramis.' },
	{ when: 'Alternance', what: 'Développeur en entreprise', detail: 'Le terrain de Turbo Selector : un problème de performance réel, une solution mathématique.' },
	{ when: 'Stage', what: 'ESN à Lyon', detail: 'Décroché grâce à Telebox, mon premier produit vendu.' },
];
---

<Base
	title="À propos — Evan Hugues, ingénieur logiciel"
	description="Ingénieur logiciel, cofondateur et CTO d’Artinova, diplômé d’un BUT Informatique à l’IUT de Valence. Parcours, méthode de travail et compétences."
	image="/og/a-propos.png"
	type="profile"
	jsonLd={graph(profilePage, personNode(), artinovaNode(), breadcrumbNode([{ name: 'Accueil', path: '/' }, { name: 'À propos', path: '/a-propos/' }]))}
>
	<header class="head wrap">
		<div class="head-text">
			<p class="label">À propos</p>
			<h1 class="h1">Du code au serveur qui l’héberge.</h1>
			<p class="lead">
				Je suis {site.name}, ingénieur logiciel et cofondateur d’<a class="u-link" href={artinova.url} rel="noopener">Artinova</a>. Je
				construis des applications de bout en bout, de la conception d’API à l’infrastructure qui les fait tourner.
			</p>
		</div>
		<figure class="necker" aria-hidden="true">
			<svg viewBox="0 0 220 220">
				<g class="edges">
					<rect x="30" y="70" width="120" height="120" />
					<rect x="70" y="30" width="120" height="120" />
					<line x1="30" y1="70" x2="70" y2="30" />
					<line x1="150" y1="70" x2="190" y2="30" />
					<line x1="150" y1="190" x2="190" y2="150" />
					<line x1="30" y1="190" x2="70" y2="150" />
				</g>
				<polygon class="face face-a" points="30,70 150,70 150,190 30,190" />
				<polygon class="face face-b" points="70,30 190,30 190,150 70,150" />
			</svg>
			<figcaption class="label">Cube de Necker : deux lectures, un seul dessin.</figcaption>
		</figure>
	</header>

	<section class="wrap block" aria-labelledby="today">
		<h2 id="today" class="block-title">Aujourd’hui</h2>
		<div class="prose block-body">
			<p>
				Je suis cofondateur et CTO d’Artinova, un logiciel qui accompagne les artisans du bâtiment du premier appel client jusqu’au
				paiement. Je porte l’architecture, le back-end, l’infrastructure et la qualité, et je code tous les jours : un monolithe
				modulaire en TypeScript, des files de jobs, PostgreSQL, AWS décrit en Terraform, et la facture électronique qui devient
				obligatoire en 2026.
			</p>
			<p>
				À côté, je continue de construire : une marketplace musicale avec un worker Rust, un gestionnaire de presse-papiers pour
				Linux, un bloqueur de publicités. Mes projets ne vivent pas que sur GitHub : ils tournent, et je les exploite.
			</p>
		</div>
	</section>

	<section class="wrap block" aria-labelledby="path">
		<h2 id="path" class="block-title">Parcours</h2>
		<ol class="timeline block-body">
			{
				path.map((p) => (
					<li>
						<span class="label when">{p.when}</span>
						<span class="what">{p.what}</span>
						<span class="detail">{p.detail}</span>
					</li>
				))
			}
		</ol>
	</section>

	<section class="wrap block" aria-labelledby="method">
		<h2 id="method" class="block-title">Méthode</h2>
		<div class="prose block-body">
			<ul>
				<li><strong>Des invariants plutôt que des espoirs.</strong> Ce qui ne doit jamais arriver est garanti au plus bas niveau possible : contrainte en base, type, test.</li>
				<li><strong>Écrire les décisions.</strong> Un choix d’architecture qui compte a son ADR : le contexte, les options, ce qu’on accepte de perdre.</li>
				<li><strong>Le bon outil par service.</strong> TypeScript pour le produit, Rust pour la fiabilité et le calcul, Python pour la data et l’IA.</li>
				<li><strong>La sécurité comme réflexe.</strong> Je pratique l’offensif sur Root-Me et Hack The Box, et j’audite mes propres projets : on construit mieux quand on sait casser.</li>
				<li><strong>Exploiter ce que je livre.</strong> Conteneurs durcis, CI/CD, auto-hébergement, supervision : la mise en production fait partie du travail.</li>
			</ul>
		</div>
	</section>

	<section class="wrap block" aria-labelledby="skills">
		<h2 id="skills" class="block-title">Compétences</h2>
		<dl class="skills block-body">
			{
				skills.map((s) => (
					<div>
						<dt class="label">{s.domain}</dt>
						<dd>{s.text}</dd>
					</div>
				))
			}
		</dl>
	</section>

	<section class="wrap block" aria-labelledby="elsewhere">
		<h2 id="elsewhere" class="block-title">Ailleurs</h2>
		<ul class="links block-body">
			{
				socials.map((s) => (
					<li>
						<a class="u-link" href={s.href} rel="noopener">
							{s.label} <span aria-hidden="true">↗</span>
						</a>
					</li>
				))
			}
			<li><a class="u-link" href="/contact/">Me contacter <span aria-hidden="true">→</span></a></li>
		</ul>
	</section>
</Base>

<style>
	.head {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		align-items: center;
		column-gap: 1.25rem;
		row-gap: 3rem;
		padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 7rem));
		padding-bottom: clamp(3rem, 7vw, 6rem);
	}

	.head-text {
		grid-column: 1 / span 8;
		display: grid;
		gap: 1.8rem;
	}

	.head-text .lead {
		max-width: 32ch;
	}

	.necker {
		grid-column: 9 / span 4;
		display: grid;
		gap: 1rem;
		justify-items: center;
	}

	.necker svg {
		width: min(100%, 22rem);
		overflow: visible;
	}

	.edges {
		fill: none;
		stroke: var(--fg);
		stroke-width: 2;
	}

	.face {
		fill: var(--fg);
		opacity: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		html:not([data-motion='off']) .face-a {
			animation: necker 6s var(--ease-in-out) infinite;
		}

		html:not([data-motion='off']) .face-b {
			animation: necker 6s var(--ease-in-out) 3s infinite;
		}
	}

	@keyframes necker {
		0%,
		45%,
		100% {
			opacity: 0;
		}
		15%,
		30% {
			opacity: 0.16;
		}
	}

	.block {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: 1.25rem;
		row-gap: 1.5rem;
		padding-block: clamp(3rem, 6vw, 5.5rem);
		border-top: 1px solid var(--line);
	}

	.block-title {
		grid-column: 1 / span 4;
		font-size: clamp(1.6rem, 3vw, 2.8rem);
		font-weight: 800;
		font-stretch: 75%;
		line-height: 1.02;
		text-transform: uppercase;
	}

	.block-body {
		grid-column: 5 / span 8;
	}

	.timeline li {
		display: grid;
		grid-template-columns: 11rem minmax(0, 1fr);
		grid-template-areas:
			'when what'
			'when detail';
		column-gap: 1.5rem;
		row-gap: 0.3rem;
		padding-block: 1.2rem;
		border-bottom: 1px solid var(--line);
	}

	.timeline li:first-child {
		padding-top: 0;
	}

	.when {
		grid-area: when;
		padding-top: 0.25rem;
		color: var(--fg);
	}

	.what {
		grid-area: what;
		font-size: 1.2rem;
		font-weight: 650;
	}

	.detail {
		grid-area: detail;
		color: var(--muted);
	}

	.skills {
		display: grid;
		border-top: 1px solid var(--line);
	}

	.skills div {
		display: grid;
		grid-template-columns: 8rem minmax(0, 1fr);
		gap: 1rem;
		padding-block: 1rem;
		border-bottom: 1px solid var(--line);
	}

	.skills dt {
		padding-top: 0.2rem;
		color: var(--fg);
	}

	.skills dd {
		color: color-mix(in srgb, var(--fg) 82%, var(--bg));
		line-height: 1.55;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2.5rem;
		font-size: var(--t-lead);
		font-weight: 600;
	}

	@media (max-width: 860px) {
		.head-text,
		.necker,
		.block-title,
		.block-body {
			grid-column: 1 / -1;
		}

		.necker {
			justify-items: start;
		}

		.timeline li,
		.skills div {
			grid-template-columns: 1fr;
			grid-template-areas: 'when' 'what' 'detail';
		}
	}
</style>
