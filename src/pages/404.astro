---
import Base from '@layouts/Base.astro';
import PenroseStairs from '@components/posters/PenroseStairs.astro';
---

<Base
	title="Page introuvable — Evan Hugues"
	description="Cette adresse ne mène nulle part : la page n’existe pas, ou plus. Retour à l’accueil ou aux projets d’Evan Hugues, ingénieur logiciel."
	noindex
>
	<section class="nf wrap">
		<div class="copy">
			<h1>
				<span class="code display">404</span><span class="sr-only"> — </span>
				<span class="msg h2">Vous tournez en rond.</span>
			</h1>
			<p class="lead">
				Cette adresse ne mène nulle part : la page n’existe pas, ou plus. Comme cet escalier, on peut monter longtemps sans jamais
				arriver.
			</p>
			<div class="actions">
				<a class="btn btn--solid" href="/">Retour à l’accueil</a>
				<a class="u-link" href="/projets/">Voir les projets</a>
			</div>
		</div>

		<div class="art">
			<div class="stage" data-stairs>
				<PenroseStairs class="poster" />
				<canvas aria-hidden="true"></canvas>
			</div>
			<p class="hint label" aria-hidden="true">
				<span class="hint-fine">Faites glisser l’escalier pour voir le truc</span><span class="hint-touch"
					>Glissez sur l’escalier pour voir le truc</span
				>
			</p>
		</div>
	</section>
</Base>

<script>
	import '@client/notfound/boot';
</script>

<style>
	.nf {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		align-items: center;
		gap: clamp(2rem, 5vw, 6rem);
		min-height: 100svh;
		padding-top: calc(var(--header-h) + 2rem);
		padding-bottom: 3rem;
	}

	h1 {
		display: grid;
		gap: 1.2rem;
	}

	.code {
		font-size: clamp(6rem, 17vw, 17rem);
		line-height: 0.82;
	}

	.msg {
		display: block;
	}

	.copy {
		display: grid;
		gap: 2rem;
	}

	.lead {
		max-width: 30ch;
		color: color-mix(in srgb, var(--fg) 85%, var(--bg));
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.5rem 2rem;
	}

	.art {
		display: grid;
		gap: 1rem;
		justify-items: center;
	}

	.stage {
		position: relative;
		width: min(100%, 44rem);
		aspect-ratio: 7 / 8;
	}

	.stage :global(.poster) {
		position: absolute;
		inset: 6% 8%;
		display: grid;
		place-items: center;
	}

	.stage canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		touch-action: pan-y;
		transition: opacity 0.8s var(--ease-out);
	}

	.stage[data-ready] canvas {
		opacity: 1;
	}

	.stage[data-ready] :global(.poster) {
		visibility: hidden;
	}

	.hint {
		visibility: hidden;
	}

	.stage[data-ready] + .hint {
		visibility: visible;
	}

	.hint-touch {
		display: none;
	}

	@media (pointer: coarse) {
		.hint-fine {
			display: none;
		}

		.hint-touch {
			display: inline;
		}
	}

	@media (max-width: 820px) {
		.nf {
			grid-template-columns: minmax(0, 1fr);
			align-content: start;
			padding-top: calc(var(--header-h) + 1rem);
		}

		.art {
			order: -1;
		}

		.stage {
			width: min(100%, 26rem);
		}
	}
</style>
