---
import Base from '@layouts/Base.astro';
import { socials } from '@data/site';
import { CONTACT_EMAIL } from 'astro:env/server';
import { obfuscate } from 'altcha-lib/obfuscation';
import { breadcrumbNode, graph } from '@lib/seo';

// Chiffrée au build (format ALTCHA) : l'adresse n'existe en clair que dans le
// navigateur, après la preuve de travail. email-guard vérifie qu'elle ne fuit pas.
const payload = await obfuscate(CONTACT_EMAIL, { counterMin: 40, counterMax: 220 });
const linkedin = socials.find((s) => s.label === 'LinkedIn')!;
---

<Base
	title="Contact | Evan Hugues"
	description="Un projet sérieux, une opportunité ou une question ? Mon adresse e-mail s’affiche après une courte vérification anti-robot, sans cookie ni service tiers."
	image="/og/contact.png"
	jsonLd={graph(breadcrumbNode([{ name: 'Accueil', path: '/' }, { name: 'Contact', path: '/contact/' }]))}
	bare
>
	<section class="contact" data-contact>
		<svg class="kanizsa" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
			<g class="pac"><path d="M110 110 L110 170 A60 60 0 1 1 170 110 Z" /></g>
			<g class="pac"><path d="M290 110 L230 110 A60 60 0 1 1 290 170 Z" /></g>
			<g class="pac"><path d="M290 290 L290 230 A60 60 0 1 1 230 290 Z" /></g>
			<g class="pac"><path d="M110 290 L170 290 A60 60 0 1 1 110 230 Z" /></g>
		</svg>

		<div class="wrap stage">
			<div class="main">
				<p class="label kicker">Contact</p>
				<h1 class="question">Un projet sérieux ?<br />Écrivez-moi.</h1>
				<p class="lead sub">
					Mon adresse s’affiche après une courte vérification anti-robot. Il n’y a ni cookie ni service tiers, votre navigateur
					fait simplement un petit calcul.
				</p>

				<div class="swap">
					<div class="captcha" data-captcha data-payload={payload} data-state="idle">
						<button class="check" type="button" role="checkbox" aria-checked="false" aria-describedby="captcha-status" data-check>
							<span class="box" aria-hidden="true">
								<svg viewBox="0 0 24 24"><path d="M5 12.5 L10 17.5 L19 7" /></svg>
							</span>
							<span class="check-label">Je ne suis pas un robot</span>
						</button>
						<p class="hint label" aria-hidden="true">ou appuyez sur <kbd>Entrée ↵</kbd></p>
						<p id="captcha-status" class="status" data-status aria-live="polite"></p>
						<noscript>
							<p class="status">
								La vérification a besoin de JavaScript. Vous pouvez aussi m’écrire sur <a class="u-link" href={linkedin.href}>LinkedIn</a>.
							</p>
						</noscript>
					</div>

					<div class="result" data-result hidden>
						<p class="label verified">C’est vérifié, voici mon adresse.</p>
						<a class="email" data-email href="#"></a>
						<div class="actions">
							<button class="btn btn--solid" type="button" data-copy>Copier l’adresse</button>
							<a class="btn" data-mailto href="#">Écrire un e-mail <span class="arrow" aria-hidden="true">↗</span></a>
							<p class="label copied" data-copied aria-live="polite"></p>
						</div>
					</div>
				</div>
			</div>

			<footer class="elsewhere">
				<p class="label">Ailleurs</p>
				<ul>
					{
						socials.map((s) => (
							<li>
								<a class="u-link" href={s.href} rel="noopener">
									{s.label}
								</a>
							</li>
						))
					}
				</ul>
				<p class="label credit">La vérification repose sur une preuve de travail ALTCHA, sans cookie.</p>
			</footer>
		</div>
	</section>
</Base>

<script>
	import '@client/contact/reveal';
</script>

<style>
	.contact {
		position: relative;
		overflow: clip;
	}

	.stage {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		align-content: center;
		column-gap: 1.25rem;
		row-gap: clamp(2rem, 5vh, 3.5rem);
		min-height: 100svh;
		padding-top: calc(var(--header-h) + 2rem);
		padding-bottom: 2.5rem;
	}

	.main {
		grid-column: 1 / span 8;
		display: grid;
		gap: clamp(1.1rem, 2.6vh, 1.8rem);
	}

	.question {
		font-size: clamp(2.8rem, 7.4vw, 7.6rem);
		font-weight: 800;
		font-stretch: 75%;
		line-height: 1.04;
		letter-spacing: -0.01em;
		text-transform: uppercase;
	}

	.sub {
		max-width: 36ch;
		font-size: clamp(1.1rem, 1.7vw, 1.55rem);
		color: color-mix(in srgb, var(--fg) 78%, var(--bg));
	}

	/* L'étape « case » et l'étape « adresse » occupent la même place. */
	.swap {
		display: grid;
		margin-top: 0.4rem;
	}

	.swap > * {
		grid-area: 1 / 1;
	}

	/* --- Case à cocher --- */
	.captcha {
		display: grid;
		justify-items: start;
		align-content: start;
		gap: 0.8rem;
		transition:
			opacity 0.45s var(--ease-out),
			translate 0.6s var(--ease-out);
	}

	.captcha[data-state='done'] {
		opacity: 0;
		translate: 0 -1.5rem;
		pointer-events: none;
		visibility: hidden;
		transition:
			opacity 0.45s var(--ease-out),
			translate 0.6s var(--ease-out),
			visibility 0s linear 0.6s;
	}

	.check {
		display: inline-flex;
		align-items: center;
		gap: 1.1rem;
		padding: 1rem 1.6rem 1rem 1.1rem;
		border: 1px solid var(--line-strong);
		border-radius: 2px;
		background: var(--bg-raised);
		font-size: clamp(1.15rem, 2vw, 1.5rem);
		font-weight: 600;
		transition: border-color 0.3s var(--ease-out);
	}

	.check:hover:not(:disabled) {
		border-color: var(--fg);
	}

	.box {
		position: relative;
		display: grid;
		place-items: center;
		width: 2.2rem;
		height: 2.2rem;
		border: 2px solid var(--fg);
		transition: background 0.3s var(--ease-out);
	}

	.box svg {
		width: 1.6rem;
		fill: none;
		stroke: var(--bg);
		stroke-width: 3;
		stroke-dasharray: 22;
		stroke-dashoffset: 22;
		transition: stroke-dashoffset 0.5s var(--ease-out) 0.1s;
	}

	[data-state='working'] .box {
		border-color: var(--muted);
		border-top-color: var(--fg);
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}

	[data-state='done'] .box {
		background: var(--fg);
	}

	[data-state='done'] .box svg {
		stroke-dashoffset: 0;
	}

	@keyframes spin {
		to {
			transform: rotate(1turn);
		}
	}

	.hint kbd {
		font: inherit;
		color: var(--fg);
		padding: 0.2em 0.5em;
		border: 1px solid var(--line-strong);
		border-radius: 2px;
	}

	.status {
		min-height: 1.5em;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	[data-state='error'] .status {
		color: var(--signal);
	}

	/* --- Adresse révélée --- */
	.result {
		display: grid;
		align-content: start;
		gap: 1.1rem;
	}

	.verified {
		color: var(--fg);
	}

	.email {
		display: block;
		width: fit-content;
		max-width: 100%;
		font-size: clamp(2rem, 6vw, 5.6rem);
		font-weight: 800;
		font-stretch: 75%;
		line-height: 1;
		letter-spacing: -0.005em;
		overflow-wrap: anywhere;
		perspective: 900px;
	}

	.email :global(.ch) {
		display: inline-block;
		white-space: pre;
	}

	@media (prefers-reduced-motion: no-preference) {
		html:not([data-motion='off']) .email :global(.ch) {
			opacity: 0;
			transform: translate3d(0, 0, calc(var(--z) * 1px)) rotateY(calc(var(--r) * 1deg));
			transition:
				transform 1.1s var(--ease-out),
				opacity 0.5s linear;
			transition-delay: calc(0.25s + var(--i) * 28ms);
		}

		html:not([data-motion='off']) .result:global(.is-in) .email :global(.ch) {
			opacity: 1;
			transform: none;
		}
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.8rem 1.2rem;
	}

	.copied {
		color: var(--fg);
	}

	/* --- Ailleurs --- */
	.elsewhere {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.8rem 2rem;
		padding-top: 1.4rem;
		border-top: 1px solid var(--line);
	}

	.elsewhere ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		font-weight: 600;
	}

	.credit {
		margin-left: auto;
		color: var(--faint);
	}

	/* --- Illusion de Kanizsa : un carré qui n'existe pas --- */
	.kanizsa {
		position: absolute;
		right: var(--gutter);
		top: 50%;
		width: min(30vw, 30rem);
		translate: 0 -50%;
		fill: var(--fg);
	}

	.pac {
		transform-box: fill-box;
		transform-origin: center;
		transition: transform 1.2s var(--ease-in-out);
	}

	[data-revealed] .pac {
		transform: rotate(180deg);
	}

	@media (max-width: 900px) {
		.main {
			grid-column: 1 / -1;
		}

		.kanizsa {
			top: auto;
			bottom: 4rem;
			right: -5rem;
			width: 16rem;
			translate: none;
			opacity: 0.1;
		}

		.credit {
			margin-left: 0;
		}
	}
</style>
