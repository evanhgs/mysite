{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"trailingSlash": true,
	"redirects": [
		{ "source": "/en/", "destination": "/", "statusCode": 301 },
		{ "source": "/fr/about/", "destination": "/a-propos/", "statusCode": 301 },
		{ "source": "/en/about/", "destination": "/a-propos/", "statusCode": 301 },
		{ "source": "/fr/projets/", "destination": "/projets/", "statusCode": 301 },
		{ "source": "/en/projects/", "destination": "/projets/", "statusCode": 301 },
		{ "source": "/fr/projets/sae5-aramis/", "destination": "/projets/aramis/", "statusCode": 301 },
		{ "source": "/en/projects/sae5-aramis/", "destination": "/projets/aramis/", "statusCode": 301 },
		{ "source": "/fr/projets/:slug(rmce|turbo-selector|valenstagram|telebox)/", "destination": "/projets/:slug/", "statusCode": 301 },
		{ "source": "/en/projects/:slug(rmce|turbo-selector|valenstagram|telebox)/", "destination": "/projets/:slug/", "statusCode": 301 },
		{ "source": "/fr/projets/:slug(dashdust|hibiki|wipytest)/", "destination": "/projets/", "statusCode": 301 },
		{ "source": "/en/projects/:slug(dashdust|hibiki|wipytest)/", "destination": "/projets/", "statusCode": 301 },
		{ "source": "/fr/blog/", "destination": "/projets/", "statusCode": 301 },
		{ "source": "/en/blog/", "destination": "/projets/", "statusCode": 301 },
		{ "source": "/fr/blog/:slug(telebox|turbo-selector|valenstagram)/", "destination": "/projets/:slug/", "statusCode": 301 },
		{ "source": "/fr/blog/:path*", "destination": "/projets/", "statusCode": 301 },
		{ "source": "/en/:path*", "destination": "/", "statusCode": 301 },
		{ "source": "/rss.xml", "destination": "/", "statusCode": 301 },
		{ "source": "/og.png", "destination": "/og/accueil.png", "statusCode": 301 },
		{ "source": "/favicon.svg", "destination": "/icon.svg", "statusCode": 301 }
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Content-Security-Policy",
					"value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
				},
				{ "key": "X-Content-Type-Options", "value": "nosniff" },
				{ "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
				{ "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
				{
					"key": "Permissions-Policy",
					"value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()"
				}
			]
		},
		{
			"source": "/_astro/(.*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
		},
		{
			"source": "/(og|covers)/(.*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
		}
	]
}
